# agent-sdlc: transient workspace and runtime state are local-only
.ai/workspace/
.ai/runtime/
# jig: settings for one clone only (ADR-0038)
.ai/config.local.yaml

.idea/
.DS_Store
CLAUDE.local.md
# Claude Code settings of one user (permissions and the like).
.claude/settings.local.json

# Test-run output. Logs belong outside the repository (conventions/shell.md);
