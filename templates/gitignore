# jig: transient workspace and runtime state are local-only. No trailing slash:
# a checkout that shares another one's workspace through a directory link has
# `.ai/workspace/tasks` as a link rather than a directory, and a rule ending in
# `/` matches only a directory, so such a checkout reported its workspace
# untracked.
.ai/workspace
.ai/runtime
# jig: settings for one clone only (ADR-0038)
.ai/config.local.yaml

# Test-run output. Logs belong outside the repository (conventions/shell.md);
# this is the net under that rule, because one of them reached the index once.
*.log

# Claude Code sessions create worktrees inside the repository; one such
# nested worktree once reached the index as a gitlink.
.claude/worktrees/
