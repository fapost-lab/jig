#!/usr/bin/env bash
# Backstop for hooks/pre-commit: refuse pushing directly to the base branch.
#
# The pre-commit hook can be bypassed with --no-verify, and a commit made on
# another machine or before the hook was enabled carries no mark. This is the
# last local checkpoint before the work leaves the machine.
#
# Escape hatch: `git push --no-verify`.
set -eu

base=$(sed -n 's/^git.base_branch:[[:space:]]*//p' .ai/config.yaml 2>/dev/null \
  | sed 's/[[:space:]]*#.*//' | head -n 1)
[ -n "$base" ] || base=main

# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>, one line per ref.
status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  if [ "$remote_ref" = "refs/heads/$base" ]; then
    printf 'refusing to push directly to %s.\n\n' "$base" >&2
    printf 'Open a pull request from a task branch, or bypass with:\n' >&2
    printf '  git push --no-verify\n' >&2
    status=1
  fi
done
exit "$status"
